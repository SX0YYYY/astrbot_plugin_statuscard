{
  "avatar": {
    "description": "头像",
    "type": "object",
    "items": {
      "avatar_upload_files": {
        "description": "上传头像图片",
        "type": "file",
        "default": [],
        "file_types": ["png", "jpg", "jpeg", "webp", "gif"],
        "hint": "在配置页直接上传头像图片，上传后会自动加入列表，取列表第一张生效。优先级高于本地路径、头像 URL 和 QQ 头像。"
      },
      "avatar_local_path": {
        "description": "自定义头像本地路径",
        "type": "string",
        "default": "",
        "hint": "填写后优先读取本地文件；读取失败会回退到 avatar_url 或 QQ 头像。"
      },
      "avatar_url": {
        "description": "自定义头像图片 URL",
        "type": "string",
        "default": "",
        "hint": "留空时自动使用 Bot 的 QQ 头像。"
      },
      "avatar_text": {
        "description": "状态图显示的 Bot 名称",
        "type": "string",
        "default": "",
        "hint": "留空时自动读取 OneBot 登录昵称。"
      }
    }
  },
  "background": {
    "description": "背景",
    "type": "object",
    "items": {
      "bg_upload_files": {
        "description": "上传背景图片",
        "type": "file",
        "default": [],
        "file_types": ["png", "jpg", "jpeg", "webp", "gif"],
        "hint": "在配置页直接上传背景图片，上传后会自动加入列表，取列表第一张生效。聊天中随命令发送的图片优先；其次是这里上传的背景；最后才使用 bg_provider。"
      },
      "bg_provider": {
        "description": "背景获取来源（主）",
        "type": "string",
        "default": "none",
        "options": ["none", "local", "loli", "lolicon", "loli&lolicon"],
        "hint": "none=内置背景；local=本地文件/目录；loli/lolicon=在线随机二次元图。"
      },
      "bg_fallback_chain": {
        "description": "背景回退链",
        "type": "string",
        "default": "none",
        "hint": "逗号分隔，主来源失败后按顺序尝试。"
      },
      "bg_local_path": {
        "description": "本地背景路径（文件或目录）",
        "type": "string",
        "default": "",
        "hint": "目录会随机抽取其中的图片。"
      },
      "bg_preload_count": {
        "description": "预加载背景数量",
        "type": "int",
        "default": 1
      },
      "bg_req_timeout": {
        "description": "在线背景请求超时（秒）",
        "type": "int",
        "default": 10
      },
      "bg_proxy": {
        "description": "在线背景请求代理",
        "type": "string",
        "default": "",
        "hint": "留空不使用代理。"
      },
      "bg_lolicon_r18_type": {
        "description": "Lolicon R18 类型",
        "type": "int",
        "default": 0,
        "hint": "0=正常，1=R18，2=混合；仅 lolicon 来源生效。"
      }
    }
  },
  "display": {
    "description": "状态卡显示",
    "type": "object",
    "items": {
      "process_top_n": {
        "description": "进程表显示条数",
        "type": "int",
        "default": 8
      },
      "cooldown_seconds": {
        "description": "状态卡冷却（秒）",
        "type": "int",
        "default": 10,
        "hint": "同一会话内重复触发的最小间隔；生成期间不会重复渲染；0 表示关闭冷却。"
      },
      "access": {
        "description": "状态卡访问权限（管理员内部）",
        "type": "string",
        "default": "admin",
        "options": ["all", "admin", "allowlist"],
        "hint": "所有状态卡命令已强制仅 AstrBot 管理员可触发。此项只能在管理员范围内进一步收紧：all=所有管理员；admin=仅管理员；allowlist=管理员+白名单。"
      },
      "allowlist": {
        "description": "状态卡白名单",
        "type": "list",
        "default": [],
        "items": {"type": "string"},
        "hint": "可填群号、用户号或完整 UMO；仅 access=allowlist 时生效，且不能放行非管理员。"
      },
      "redact": {
        "description": "状态卡脱敏项",
        "type": "list",
        "default": [],
        "items": {"type": "string"},
        "hint": "可选 hostname/process/network/qq_stats；公开群建议至少 hostname,process,qq_stats。"
      },
      "privacy_notice": {
        "description": "首次触发隐私提示",
        "type": "bool",
        "default": true,
        "hint": "每个会话首次出图前提示状态图会发送到 T2I 服务。"
      },
      "progress_notice": {
        "description": "出图前进度提示",
        "type": "bool",
        "default": true,
        "hint": "T2I 较慢时建议开启；关闭后只发最终图片。"
      },
      "render_quality": {
        "description": "T2I 清晰度",
        "type": "string",
        "default": "ultra",
        "options": ["normal", "high", "ultra"],
        "hint": "normal 更快，ultra 更清晰；出图慢可先降到 high 或 normal。"
      },
      "render_timeout": {
        "description": "T2I 渲染超时（秒）",
        "type": "int",
        "default": 180,
        "hint": "30-600；超时后回退为文字摘要。"
      },
      "website_targets": {
        "description": "网站测试目标",
        "type": "template_list",
        "default": [
          {"__template_key": "site", "name": "Baidu", "url": "https://www.baidu.com/"}
        ],
        "templates": {
          "site": {
            "name": "网站",
            "display_item": "name",
            "items": {
              "name": {
                "description": "显示名称",
                "type": "string",
                "default": ""
              },
              "url": {
                "description": "URL",
                "type": "string",
                "default": ""
              },
              "timeout_seconds": {
                "description": "超时（秒）",
                "type": "int",
                "default": 3,
                "hint": "单个网站请求的超时；国内服务器不建议给 Google 之类站点设太长。"
              }
            }
          }
        }
      },
      "website_cache_seconds": {
        "description": "网站测试缓存（秒）",
        "type": "int",
        "default": 60,
        "hint": "同一批目标在该时间内复用结果，避免每次出图都请求外网；0 表示关闭。"
      },
      "disk_paths": {
        "description": "磁盘挂载点",
        "type": "list",
        "default": ["/"],
        "items": {
          "type": "string"
        },
        "hint": "例如 [\"/\"] 或 [\"/\", \"/data\"]；Windows 可填 [\"C:\\\\\"]。"
      },
      "timezone": {
        "description": "时间与每日摘要时区",
        "type": "string",
        "default": "Asia/Shanghai"
      }
    }
  },
  "alerts": {
    "description": "主动告警（默认关闭）",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用资源阈值与掉线告警",
        "type": "bool",
        "default": false,
        "hint": "只控制 CPU/内存/磁盘阈值和掉线告警；每日摘要由独立开关控制，无需打开本项。"
      },
      "targets": {
        "description": "告警推送目标",
        "type": "list",
        "default": [],
        "items": {
          "type": "string"
        },
        "hint": "支持完整 UMO（platform_id:GroupMessage:群号）或纯群号；阈值告警、每日摘要和服务监测都会复用这里。"
      },
      "platform_id": {
        "description": "默认平台实例 ID",
        "type": "string",
        "default": "default",
        "hint": "纯群号会转换为 <platform_id>:GroupMessage:<群号>。"
      },
      "interval_seconds": {
        "description": "告警采样间隔（秒）",
        "type": "int",
        "default": 60,
        "hint": "最低 15 秒。"
      },
      "sustain_samples": {
        "description": "连续超过阈值多少次才告警",
        "type": "int",
        "default": 3
      },
      "cooldown_seconds": {
        "description": "同一规则告警冷却（秒）",
        "type": "int",
        "default": 1800
      },
      "cpu_threshold": {
        "description": "CPU 使用率阈值（%）",
        "type": "int",
        "default": 85
      },
      "mem_threshold": {
        "description": "内存使用率阈值（%）",
        "type": "int",
        "default": 90
      },
      "swap_threshold": {
        "description": "SWAP 使用率阈值（%）",
        "type": "int",
        "default": 90
      },
      "disk_threshold": {
        "description": "磁盘使用率阈值（%）",
        "type": "int",
        "default": 85
      },
      "load_per_core_threshold": {
        "description": "每核负载阈值",
        "type": "float",
        "default": 2.0
      },
      "recover_notify": {
        "description": "恢复时发送通知",
        "type": "bool",
        "default": true
      },
      "offline_notify": {
        "description": "Bot 掉线/恢复通知",
        "type": "bool",
        "default": true
      },
      "daily_summary": {
        "description": "每日状态摘要",
        "type": "object",
        "items": {
          "enabled": {
            "description": "启用每日摘要",
            "type": "bool",
            "default": false,
            "hint": "独立开关，不需要打开 alerts.enabled；发送目标复用 alerts.targets。"
          },
          "time": {
            "description": "发送时间（HH:MM）",
            "type": "string",
            "default": "09:00"
          },
          "with_image": {
            "description": "附带状态图",
            "type": "bool",
            "default": true,
            "hint": "渲染失败时自动降级为文字摘要。"
          }
        }
      },
      "komari_webhook": {
        "description": "Komari Webhook 转发",
        "type": "object",
        "items": {
          "enabled": {
            "description": "启用 Webhook 接收",
            "type": "bool",
            "default": false
          },
          "host": {
            "description": "监听地址",
            "type": "string",
            "default": "127.0.0.1",
            "hint": "Komari 与本插件同机时用 127.0.0.1 即可，避免暴露公网。"
          },
          "port": {
            "description": "监听端口",
            "type": "int",
            "default": 9968
          },
          "path": {
            "description": "Webhook 路径",
            "type": "string",
            "default": "/webhook"
          },
          "token": {
            "description": "鉴权 Token",
            "type": "string",
            "default": "",
            "is_password": true,
            "hint": "填写后 Komari 请求头需带 Authorization: Bearer <token>。"
          }
        }
      }
    }
  },
  "monitors": {
    "description": "服务监测（类似 Uptime Kuma）",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用服务监测",
        "type": "bool",
        "default": false,
        "hint": "启用后按设定间隔检查目标，连续失败会推送到 QQ 群。"
      },
      "interval_seconds": {
        "description": "轮询间隔（秒）",
        "type": "int",
        "default": 60,
        "hint": "最低 15 秒。"
      },
      "fail_threshold": {
        "description": "连续失败多少次告警",
        "type": "int",
        "default": 2
      },
      "cooldown_seconds": {
        "description": "同一目标告警/重试冷却（秒）",
        "type": "int",
        "default": 1800
      },
      "recover_notify": {
        "description": "恢复时发送通知",
        "type": "bool",
        "default": true
      },
      "max_response_bytes": {
        "description": "HTTP 探测最大读取字节数",
        "type": "int",
        "default": 262144,
        "hint": "只有配置了 keyword 时才读取响应体；超过该值会截断，避免误配大文件拖垮内存。"
      },
      "targets": {
        "description": "监测告警推送目标",
        "type": "list",
        "default": [],
        "items": {
          "type": "string"
        },
        "hint": "支持完整 UMO 或纯群号；留空时复用 alerts.targets。"
      },
      "items": {
        "description": "监测目标列表",
        "type": "template_list",
        "default": [],
        "templates": {
          "http": {
            "name": "HTTP 网站",
            "display_item": "name",
            "items": {
              "name": {
                "description": "名称",
                "type": "string",
                "default": ""
              },
              "url": {
                "description": "URL",
                "type": "string",
                "default": ""
              },
              "expected_status": {
                "description": "期望状态码",
                "type": "int",
                "default": 0,
                "hint": "0 表示任意 2xx/3xx；填写具体值则精确匹配。"
              },
              "keyword": {
                "description": "响应关键字（可选）",
                "type": "string",
                "default": ""
              },
              "timeout_seconds": {
                "description": "超时（秒）",
                "type": "int",
                "default": 10
              },
              "enabled": {
                "description": "启用",
                "type": "bool",
                "default": true
              }
            }
          },
          "tcp": {
            "name": "TCP 端口",
            "display_item": "name",
            "items": {
              "name": {
                "description": "名称",
                "type": "string",
                "default": ""
              },
              "host": {
                "description": "主机",
                "type": "string",
                "default": "127.0.0.1"
              },
              "port": {
                "description": "端口",
                "type": "int",
                "default": 0
              },
              "timeout_seconds": {
                "description": "超时（秒）",
                "type": "int",
                "default": 10
              },
              "enabled": {
                "description": "启用",
                "type": "bool",
                "default": true
              }
            }
          },
          "docker": {
            "name": "Docker 容器",
            "display_item": "name",
            "items": {
              "name": {
                "description": "名称",
                "type": "string",
                "default": ""
              },
              "container": {
                "description": "容器名",
                "type": "string",
                "default": ""
              },
              "timeout_seconds": {
                "description": "超时（秒）",
                "type": "int",
                "default": 10
              },
              "enabled": {
                "description": "启用",
                "type": "bool",
                "default": true
              }
            }
          },
          "process": {
            "name": "进程",
            "display_item": "name",
            "items": {
              "name": {
                "description": "名称",
                "type": "string",
                "default": ""
              },
              "pattern": {
                "description": "进程名/命令行关键字",
                "type": "string",
                "default": ""
              },
              "enabled": {
                "description": "启用",
                "type": "bool",
                "default": true
              }
            }
          },
          "systemd": {
            "name": "systemd 服务",
            "display_item": "name",
            "items": {
              "name": {
                "description": "名称",
                "type": "string",
                "default": ""
              },
              "unit": {
                "description": "unit 名称",
                "type": "string",
                "default": "",
                "hint": "例如 astrbot.service、nginx.service。"
              },
              "timeout_seconds": {
                "description": "超时（秒）",
                "type": "int",
                "default": 10
              },
              "enabled": {
                "description": "启用",
                "type": "bool",
                "default": true
              }
            }
          }
        }
      }
    }
  }
}
