{
  "display": {
    "description": "状态卡显示",
    "type": "object",
    "hint": "默认设置即可直接使用；需要调整图片尺寸、网站测试、时区或脱敏时，再打开“显示高级选项”。",
    "items": {
      "render_width": {
        "description": "输出图片宽度（像素）",
        "type": "int",
        "default": 1170,
        "slider": {
          "min": 1170,
          "max": 2880,
          "step": 30
        },
        "hint": "越大越清晰，T2I 渲染也越慢；手机看 1170 足够。"
      },
      "language": {
        "description": "命令提示语言",
        "type": "string",
        "default": "zh-CN",
        "hint": "只影响 QQ 命令提示；页面跟随 AstrBot WebUI 语言。"
      },
      "process_top_n": {
        "description": "进程表显示条数",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 1,
          "max": 30,
          "step": 1
        },
        "hint": "状态卡进程表显示条数，3–20；CPU 以占整机百分比显示（已除以 CPU 核数）。日报的 Top 进程条数在“日报 → 高级”里单独设置。"
      },
      "compact": {
        "description": "手机紧凑模式",
        "type": "bool",
        "default": false,
        "hint": "手机上看图更方便：隐藏系统信息表、进程最多 5 行、放大资源百分比。"
      },
      "progress_notice": {
        "description": "出图前发送“生成中”提示",
        "type": "bool",
        "default": true,
        "hint": "首次出图通常需要数秒到数十秒；关闭后不再发送“生成中”提示。"
      },
      "show_advanced": {
        "description": "显示高级显示选项",
        "type": "bool",
        "default": false,
        "hint": "冷却、网站测试、磁盘路径、时区、隐私与权限等；通常不需要改。"
      },
      "cooldown_seconds": {
        "description": "同一会话冷却（秒）",
        "type": "int",
        "default": 10,
        "slider": {
          "min": 0,
          "max": 3600,
          "step": 5
        },
        "condition": {
          "show_advanced": true
        },
        "hint": "同一会话重复触发状态卡的最小间隔；0 表示不限制。"
      },
      "website_targets": {
        "description": "网站测试目标",
        "type": "template_list",
        "default": [
          {
            "__template_key": "site",
            "name": "Baidu",
            "url": "https://www.baidu.com/"
          }
        ],
        "condition": {
          "show_advanced": true
        },
        "hint": "状态卡和日报共用这些目标；默认只测百度，单个目标超时 3 秒。",
        "templates": {
          "site": {
            "name": "网站",
            "items": {
              "name": {
                "description": "显示名称",
                "type": "string",
                "default": "",
                "hint": "例如 百度"
              },
              "url": {
                "description": "网址",
                "type": "string",
                "default": "",
                "hint": "例如 https://www.baidu.com/"
              },
              "timeout_seconds": {
                "description": "超时（秒）",
                "type": "int",
                "default": 3,
                "invisible": true
              }
            }
          }
        }
      },
      "website_cache_seconds": {
        "description": "网站测试缓存（秒）",
        "type": "int",
        "default": 60,
        "slider": {
          "min": 0,
          "max": 3600,
          "step": 10
        },
        "condition": {
          "show_advanced": true
        },
        "hint": "同一批目标在该时间内复用结果，避免每次出图都请求外网；0 表示关闭。"
      },
      "disk_paths": {
        "description": "磁盘挂载点",
        "type": "list",
        "default": [],
        "items": {
          "type": "string"
        },
        "condition": {
          "show_advanced": true
        },
        "hint": "留空自动检测；Linux 通常填 `/`，Windows 填 `C:\\`。"
      },
      "timezone": {
        "description": "时区",
        "type": "string",
        "default": "Asia/Shanghai",
        "condition": {
          "show_advanced": true
        },
        "hint": "状态卡、告警、监测和日报统一使用；修改后每分钟自动生效。"
      },
      "redact": {
        "description": "状态卡脱敏项",
        "type": "list",
        "default": [],
        "options": [
          "hostname",
          "process",
          "network",
          "qq_stats"
        ],
        "labels": [
          "主机名",
          "进程信息",
          "网络数据",
          "QQ 统计"
        ],
        "render_type": "checkbox",
        "condition": {
          "show_advanced": true
        },
        "hint": "公开群建议至少勾选“主机名”和“进程信息”；勾选“QQ 统计”会同时隐藏日报里的好友/群/群员/收发。"
      },
      "page_redact": {
        "description": "Web 看板脱敏项",
        "type": "list",
        "default": [],
        "options": [
          "hostname",
          "process",
          "network",
          "qq_stats"
        ],
        "labels": [
          "主机名",
          "进程信息",
          "网络数据",
          "QQ 统计"
        ],
        "render_type": "checkbox",
        "condition": {
          "show_advanced": true
        },
        "hint": "只影响 AstrBot WebUI 里的看板，不影响发到 QQ 的状态卡和日报。与上面的“状态卡脱敏项”完全独立：全部不勾 = 看板不做任何脱敏（会显示主机名、进程名等原始信息）。"
      },
      "privacy_notice": {
        "description": "首次触发隐私提示",
        "type": "bool",
        "default": true,
        "condition": {
          "show_advanced": true
        },
        "hint": "每个会话首次出图前提示状态图会发送到 T2I 服务。"
      },
      "render_timeout": {
        "description": "渲染超时（秒）",
        "type": "int",
        "default": 180,
        "slider": {
          "min": 30,
          "max": 600,
          "step": 10
        },
        "condition": {
          "show_advanced": true
        },
        "hint": "超时后回退为文字摘要；T2I 慢时可适当调大。"
      },
      "t2i_benchmark": {
        "description": "记录 T2I 渲染耗时",
        "type": "bool",
        "default": false,
        "condition": {
          "show_advanced": true
        },
        "hint": "排查渲染慢时开启；日志会记录状态卡和日报的渲染耗时。"
      }
    }
  },
  "alerts": {
    "description": "告警与每日定时状态图",
    "type": "object",
    "hint": "默认关闭。打开后，CPU/内存/磁盘持续过高或 Bot 掉线时往 QQ 群发消息；“每日定时状态图”可在下面单独开启。",
    "items": {
      "enabled": {
        "description": "启用资源与掉线告警",
        "type": "bool",
        "default": false,
        "hint": "资源阈值和掉线告警的总开关；不影响“每日定时状态图”和“日报”。"
      },
      "targets": {
        "description": "推送目标",
        "type": "list",
        "default": [],
        "items": {
          "type": "string"
        },
        "hint": "填 QQ 群号或完整 UMO；资源告警、掉线告警、每日定时状态图和监测默认都发到这里。"
      },
      "daily_summary": {
        "description": "每日定时状态图",
        "type": "object",
        "hint": "每天定时发送整张状态卡图片，不是趋势日报；与下面的“日报”是两件事。",
        "items": {
          "enabled": {
            "description": "启用每日定时状态图",
            "type": "bool",
            "default": false,
            "hint": "独立于上面的“启用资源与掉线告警”，可以只开定时状态图。"
          },
          "time": {
            "description": "发送时间",
            "type": "string",
            "default": "09:00",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "condition": {
              "enabled": true
            },
            "hint": "24 小时制 HH:MM，例如 20:00；修改后每分钟自动生效。"
          },
          "with_image": {
            "description": "发送状态图（关闭则发文字摘要）",
            "type": "bool",
            "default": true,
            "condition": {
              "enabled": true
            },
            "hint": "关闭后只发文字摘要；图片渲染失败也会自动回退文字。"
          }
        }
      },
      "show_advanced": {
        "description": "显示高级告警选项",
        "type": "bool",
        "default": false,
        "hint": "阈值、采样间隔、冷却、掉线通知、Komari Webhook 等；通常不需要改。"
      },
      "cpu_threshold": {
        "description": "CPU 告警阈值（%）",
        "type": "int",
        "default": 85,
        "slider": {
          "min": 0,
          "max": 100,
          "step": 1
        },
        "condition": {
          "show_advanced": true
        }
      },
      "mem_threshold": {
        "description": "内存告警阈值（%）",
        "type": "int",
        "default": 90,
        "slider": {
          "min": 0,
          "max": 100,
          "step": 1
        },
        "condition": {
          "show_advanced": true
        }
      },
      "swap_threshold": {
        "description": "SWAP 告警阈值（%）",
        "type": "int",
        "default": 90,
        "slider": {
          "min": 0,
          "max": 100,
          "step": 1
        },
        "condition": {
          "show_advanced": true
        }
      },
      "disk_threshold": {
        "description": "磁盘告警阈值（%）",
        "type": "int",
        "default": 85,
        "slider": {
          "min": 0,
          "max": 100,
          "step": 1
        },
        "condition": {
          "show_advanced": true
        }
      },
      "load_per_core_threshold": {
        "description": "每核负载告警阈值",
        "type": "float",
        "default": 2.0,
        "slider": {
          "min": 0,
          "max": 16,
          "step": 0.1
        },
        "condition": {
          "show_advanced": true
        },
        "hint": "例如 2.0 表示每个 CPU 核心平均负载超过 2.0 时告警。"
      },
      "interval_seconds": {
        "description": "采样间隔（秒）",
        "type": "int",
        "default": 60,
        "slider": {
          "min": 15,
          "max": 600,
          "step": 5
        },
        "condition": {
          "show_advanced": true
        }
      },
      "sustain_samples": {
        "description": "连续超过阈值几次才告警（资源告警）",
        "type": "int",
        "default": 3,
        "slider": {
          "min": 1,
          "max": 10,
          "step": 1
        },
        "condition": {
          "show_advanced": true
        },
        "hint": "只影响 CPU / 内存 / SWAP / 磁盘 / 每核负载；服务监测的失败阈值在「服务可用性监测」分组。默认 3 次，60 秒采样约 3 分钟。"
      },
      "cooldown_seconds": {
        "description": "同一规则告警冷却（秒）",
        "type": "int",
        "default": 1800,
        "slider": {
          "min": 0,
          "max": 86400,
          "step": 60
        },
        "condition": {
          "show_advanced": true
        },
        "hint": "同一规则成功告警后，多久内不重复提醒。"
      },
      "recover_notify": {
        "description": "恢复时发送通知",
        "type": "bool",
        "default": true,
        "condition": {
          "show_advanced": true
        }
      },
      "offline_notify": {
        "description": "Bot 掉线/恢复通知",
        "type": "bool",
        "default": true,
        "condition": {
          "show_advanced": true
        },
        "hint": "依赖 OneBot 通道；整体断线时会排队，恢复后补发。"
      },
      "platform_id": {
        "description": "平台实例 ID",
        "type": "string",
        "default": "default",
        "condition": {
          "show_advanced": true
        },
        "hint": "通常保持 default；只有多机器人需要指定时再改。"
      },
      "komari_webhook": {
        "description": "Komari Webhook",
        "type": "object",
        "condition": {
          "show_advanced": true
        },
        "hint": "接收 Komari 的 Webhook 并转发到 QQ 群；普通用户不需要配置。",
        "items": {
          "enabled": {
            "description": "启用 Webhook 接收",
            "type": "bool",
            "default": false
          },
          "host": {
            "description": "监听地址",
            "type": "string",
            "default": "127.0.0.1",
            "condition": {
              "enabled": true
            },
            "hint": "建议保持 127.0.0.1，只允许本机访问。"
          },
          "port": {
            "description": "监听端口",
            "type": "int",
            "default": 9968,
            "slider": {
              "min": 1,
              "max": 65535,
              "step": 1
            },
            "condition": {
              "enabled": true
            }
          },
          "path": {
            "description": "Webhook 路径",
            "type": "string",
            "default": "/webhook",
            "condition": {
              "enabled": true
            }
          },
          "token": {
            "description": "鉴权 Token",
            "type": "string",
            "default": "",
            "secret": true,
            "condition": {
              "enabled": true
            },
            "hint": "留空表示不校验；建议设置，且不要提交到公开仓库。"
          },
          "require_token": {
            "description": "强制要求 Token",
            "type": "bool",
            "default": true,
            "condition": {
              "enabled": true
            },
            "hint": "开启后必须配置 Token，否则 Webhook 拒绝启动；默认开启，关闭后请务必只监听 127.0.0.1。"
          }
        }
      }
    }
  },
  "daily_report": {
    "description": "日报（趋势图）",
    "type": "object",
    "hint": "每天定时发送资源趋势、异常汇总、QQ 趋势、Token、网站延迟和 Top 进程的趋势日报；默认只记录数据不发送。",
    "items": {
      "enabled": {
        "description": "启用每日日报",
        "type": "bool",
        "default": false,
        "hint": "开启后按设定时间发送趋势日报；与“每日定时状态图”不同，日报是趋势图不是整张状态卡。"
      },
      "time": {
        "description": "日报发送时间",
        "type": "string",
        "default": "21:00",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
        "condition": {
          "enabled": true
        },
        "hint": "24 小时制 HH:MM，例如 21:00；修改后每分钟自动生效。"
      },
      "targets": {
        "description": "日报推送目标",
        "type": "list",
        "default": [],
        "items": {
          "type": "string"
        },
        "condition": {
          "enabled": true
        },
        "hint": "留空复用“告警与每日定时状态图”的推送目标。"
      },
      "sections": {
        "description": "日报内容",
        "type": "list",
        "default": [
          "resource",
          "anomaly",
          "qq",
          "token"
        ],
        "options": [
          "resource",
          "anomaly",
          "qq",
          "token",
          "website",
          "process"
        ],
        "labels": [
          "资源趋势",
          "异常汇总",
          "QQ 趋势",
          "Token 消耗",
          "网站延迟",
          "Top 进程"
        ],
        "render_type": "checkbox",
        "condition": {
          "enabled": true
        },
        "hint": "只渲染勾选的模块；没有数据的模块会显示“数据积累中”。"
      },
      "with_image": {
        "description": "发送图片",
        "type": "bool",
        "default": true,
        "condition": {
          "enabled": true
        },
        "hint": "关闭后只发文字摘要；图片渲染失败时也会自动回退文字。"
      },
      "theme": {
        "description": "日报主题",
        "type": "string",
        "default": "light",
        "condition": {
          "enabled": true
        },
        "hint": "只影响日报图片，不影响状态卡。"
      },
      "history_days": {
        "description": "趋势天数",
        "type": "int",
        "default": 7,
        "slider": {
          "min": 7,
          "max": 30,
          "step": 7
        },
        "condition": {
          "enabled": true
        },
        "hint": "日报趋势图显示最近多少天，7–30 天。"
      },
      "collect": {
        "description": "记录日报历史数据",
        "type": "bool",
        "default": true,
        "hint": "只记录历史数据，不发消息；关闭后日报没有资源/网站/进程趋势。"
      },
      "show_advanced": {
        "description": "显示高级日报选项",
        "type": "bool",
        "default": false
      },
      "render_timeout": {
        "description": "日报渲染超时（秒）",
        "type": "int",
        "default": 180,
        "slider": {
          "min": 30,
          "max": 600,
          "step": 10
        },
        "condition": {
          "show_advanced": true
        },
        "hint": "超时后回退文字摘要。"
      },
      "resource_sample_seconds": {
        "description": "资源采样间隔（秒）",
        "type": "int",
        "default": 300,
        "slider": {
          "min": 60,
          "max": 1800,
          "step": 60
        },
        "condition": {
          "show_advanced": true
        }
      },
      "process_top_n": {
        "description": "Top 进程数量",
        "type": "int",
        "default": 5,
        "slider": {
          "min": 3,
          "max": 10,
          "step": 1
        },
        "condition": {
          "show_advanced": true
        },
        "hint": "日报里 CPU/内存 Top 进程的条数；状态卡的进程条数在“状态卡显示”里单独设置。"
      },
      "retention_days": {
        "description": "资源数据保留天数",
        "type": "int",
        "default": 30,
        "slider": {
          "min": 7,
          "max": 365,
          "step": 1
        },
        "condition": {
          "show_advanced": true
        }
      },
      "event_retention_days": {
        "description": "异常事件保留天数",
        "type": "int",
        "default": 90,
        "slider": {
          "min": 30,
          "max": 730,
          "step": 30
        },
        "condition": {
          "show_advanced": true
        }
      }
    }
  },
  "monitors": {
    "description": "服务可用性监测",
    "type": "object",
    "hint": "当网站、端口、Docker 容器、进程或系统服务挂掉/恢复时往 QQ 群发通知；默认关闭。",
    "items": {
      "enabled": {
        "description": "启用服务监测",
        "type": "bool",
        "default": false
      },
      "targets": {
        "description": "监测推送目标",
        "type": "list",
        "default": [],
        "items": {
          "type": "string"
        },
        "hint": "留空会自动使用上面的告警推送目标；通常只填一次。"
      },
      "items": {
        "description": "监测目标列表",
        "type": "template_list",
        "default": [],
        "hint": "支持 HTTP、TCP、Docker、进程、systemd 五种模板；每项可单独设置超时和期望状态。",
        "templates": {
          "http": {
            "name": "网站 / 接口",
            "items": {
              "name": {
                "description": "显示名称",
                "type": "string",
                "default": "",
                "hint": "例如 博客"
              },
              "url": {
                "description": "网址",
                "type": "string",
                "default": "",
                "hint": "例如 https://example.com"
              },
              "enabled": {
                "description": "启用",
                "type": "bool",
                "default": true
              },
              "show_advanced": {
                "description": "显示高级检查选项",
                "type": "bool",
                "default": false
              },
              "expected_status": {
                "description": "期望状态码",
                "type": "int",
                "default": 0,
                "condition": {
                  "show_advanced": true
                },
                "hint": "0 表示任意 2xx/3xx 都算正常；只有接口必须返回特定状态码时才填。"
              },
              "keyword": {
                "description": "响应中必须包含的文字",
                "type": "string",
                "default": "",
                "condition": {
                  "show_advanced": true
                }
              },
              "suppress_when_down": {
                "description": "依赖项异常时抑制告警",
                "type": "string",
                "default": "",
                "condition": {
                  "show_advanced": true
                },
