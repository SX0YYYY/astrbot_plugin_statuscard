{
    "display": {
        "description": "状态卡显示",
        "type": "object",
        "hint": "默认设置即可直接使用；需要调整图片尺寸、网站测试、时区或脱敏时，再打开“显示高级选项”。",
        "items": {
            "render_width": {
                "description": "输出图片宽度（像素）",
                "type": "int",
                "default": 1170,
                "slider": {
                    "min": 1170,
                    "max": 2880,
                    "step": 30
                },
                "hint": "越大越清晰，T2I 渲染也越慢；手机看 1170 足够。"
            },
            "language": {
                "description": "命令提示语言",
                "type": "string",
                "default": "zh-CN",
                "options": [
                    "zh-CN",
                    "en-US"
                ],
                "labels": [
                    "中文",
                    "English"
                ],
                "hint": "只影响 QQ 命令提示；页面跟随 AstrBot WebUI 语言。"
            },
            "process_top_n": {
                "description": "进程表显示条数",
                "type": "int",
                "default": 8,
                "slider": {
                    "min": 1,
                    "max": 30,
                    "step": 1
                },
                "hint": "状态卡进程表显示条数，1–30；CPU 以占整机百分比显示（已除以 CPU 核数）。日报的 Top 进程条数在“日报 → 高级”里单独设置。"
            },
            "compact": {
                "description": "手机紧凑模式",
                "type": "bool",
                "default": false,
                "hint": "手机上看图更方便：隐藏系统信息表、进程最多 5 行、放大资源百分比。"
            },
            "sample_seconds": {
                "description": "采样间隔（秒）",
                "type": "int",
                "default": 60,
                "slider": {
                    "min": 15,
                    "max": 600,
                    "step": 5
                },
                "condition": {
                    "show_advanced": true
                },
                "hint": "网络速率/月流量/磁盘 IO 的采样间隔，同时决定状态卡折线图的时间粒度；资源告警的采样间隔在「告警与每日定时状态图」分组单独设置。"
            },
            "progress_notice": {
                "description": "出图前发送“生成中”提示",
                "type": "bool",
                "default": true,
                "hint": "首次出图通常需要数秒到数十秒；关闭后不再发送“生成中”提示。"
            },
            "show_advanced": {
                "description": "显示高级选项",
                "type": "bool",
                "default": false,
                "hint": "冷却、网站测试、磁盘路径、时区、隐私与权限等；通常不需要改。"
            },
            "cooldown_seconds": {
                "description": "同一会话冷却（秒）",
                "type": "int",
                "default": 10,
                "slider": {
                    "min": 0,
                    "max": 3600,
                    "step": 5
                },
                "condition": {
                    "show_advanced": true
                },
                "hint": "同一会话重复触发状态卡的最小间隔；0 表示不限制。"
            },
            "website_targets": {
                "description": "网站测试目标",
                "type": "template_list",
                "default": [
                    {
                        "__template_key": "site",
                        "name": "Baidu",
                        "url": "https://www.baidu.com/"
                    }
                ],
                "condition": {
                    "show_advanced": true
                },
                "hint": "状态卡和日报共用这些目标；默认只测百度；每个目标可在条目里设 1–15 秒超时（新建默认 3 秒）；名称留空时自动使用去掉 query 与凭据的 URL。",
                "templates": {
                    "site": {
                        "name": "网站",
                        "items": {
                            "name": {
                                "description": "显示名称",
                                "type": "string",
                                "default": "",
                                "hint": "例如 百度"
                            },
                            "url": {
                                "description": "网址",
                                "type": "string",
                                "default": "",
                                "hint": "例如 https://www.baidu.com/"
                            },
                            "timeout_seconds": {
                                "description": "超时（秒）",
                                "type": "int",
                                "default": 3,
                                "slider": {
                                    "min": 1,
                                    "max": 15,
                                    "step": 1
                                },
                                "hint": "默认 3 秒；访问慢的站点可以调大，避免总是超时。"
                            }
                        }
                    }
                }
            },
            "website_cache_seconds": {
                "description": "网站测试缓存（秒）",
                "type": "int",
                "default": 60,
                "slider": {
                    "min": 0,
                    "max": 3600,
                    "step": 10
                },
                "condition": {
                    "show_advanced": true
                },
                "hint": "同一批目标在该时间内复用结果，避免每次出图都请求外网；0 表示关闭。"
            },
            "disk_paths": {
                "description": "磁盘挂载点",
                "type": "list",
                "default": [],
                "items": {
                    "type": "string"
                },
                "condition": {
                    "show_advanced": true
                },
                "hint": "留空自动检测根分区；可填多个挂载点：每块盘分别告警，状态卡分行显示，日报与看板取使用率最高的那块盘。"
            },
            "timezone": {
                "description": "时区",
                "type": "string",
                "default": "Asia/Shanghai",
                "condition": {
                    "show_advanced": true
                },
                "hint": "状态卡、告警、监测和日报统一使用；修改后每分钟自动生效。"
            },
            "redact": {
                "description": "状态卡脱敏项",
                "type": "list",
                "default": [],
                "options": [
                    "hostname",
                    "process",
                    "network",
                    "qq_stats"
                ],
                "labels": [
                    "主机名",
                    "进程信息",
                    "网络数据",
                    "QQ 统计"
                ],
                "render_type": "checkbox",
                "condition": {
                    "show_advanced": true
                },
                "hint": "公开群建议至少勾选“主机名”和“进程信息”；勾选“QQ 统计”会同时隐藏日报里的好友/群/群员/收发。"
            },
            "page_redact": {
                "description": "Web 看板脱敏项",
                "type": "list",
                "default": [],
                "options": [
                    "hostname",
                    "process",
                    "network",
                    "qq_stats"
                ],
                "labels": [
                    "主机名",
                    "进程信息",
                    "网络数据",
                    "QQ 统计"
                ],
                "render_type": "checkbox",
                "condition": {
                    "show_advanced": true
                },
                "hint": "只影响 AstrBot WebUI 里的看板，不影响发到 QQ 的状态卡和日报。与上面的“状态卡脱敏项”完全独立：全部不勾 = 看板不做任何脱敏（会显示主机名、进程名等原始信息）。"
            },
            "privacy_notice": {
                "description": "首次触发隐私提示",
                "type": "bool",
                "default": true,
                "condition": {
                    "show_advanced": true
                },
                "hint": "每个会话首次出图前提示状态图会发送到 T2I 服务。"
            },
            "render_timeout": {
                "description": "渲染超时（秒）",
                "type": "int",
                "default": 180,
                "slider": {
                    "min": 30,
                    "max": 600,
                    "step": 10
                },
                "condition": {
                    "show_advanced": true
                },
                "hint": "状态卡超时降级为本地简化卡；日报/周报先延迟重试 2 次，仍失败才回退文字版；T2I 慢时可适当调大。"
            },
            "t2i_benchmark": {
                "description": "记录 T2I 渲染耗时",
                "type": "bool",
                "default": false,
                "condition": {
                    "show_advanced": true
                },
                "hint": "排查渲染慢时开启；日志会记录状态卡和日报的渲染耗时。"
            }
        }
    },
    "avatar": {
        "description": "头像",
        "type": "object",
        "hint": "默认使用 Bot 的 QQ 头像。想换头像时，把“头像来源”改为“自定义上传”，再上传一张图片即可。",
        "items": {
            "avatar_source": {
                "description": "头像来源",
                "type": "string",
                "default": "default",
                "options": [
                    "default",
                    "upload"
                ],
                "labels": [
                    "默认（QQ 头像）",
                    "自定义上传"
                ],
                "hint": "默认会自动读取 Bot 的 QQ 头像；选择自定义上传后，在下面上传一张图片。"
            },
            "avatar_upload_files": {
                "description": "上传头像图片",
                "type": "file",
                "default": [],
                "file_types": [
                    "png",
                    "jpg",
                    "jpeg",
                    "webp",
                    "gif"
                ],
                "condition": {
                    "avatar_source": "upload"
                },
                "hint": "支持 png/jpg/webp/gif，单张不超过 10 MB；取列表第一张。"
            },
            "avatar_text": {
                "description": "状态图显示的 Bot 名称",
                "type": "string",
                "default": "",
                "hint": "留空自动读取 QQ 昵称；只影响卡片上的文字。"
            }
        }
    },
    "background": {
        "description": "背景",
        "type": "object",
        "hint": "默认使用内置背景。想换背景时，把“背景来源”改为“自定义上传”，再上传一张图片即可。",
        "items": {
            "background_source": {
                "description": "背景来源",
                "type": "string",
                "default": "default",
                "options": [
                    "default",
                    "upload"
                ],
                "labels": [
                    "默认（内置背景）",
                    "自定义上传"
                ],
                "hint": "默认使用插件自带背景；选择自定义上传后，在下面上传一张图片。"
            },
            "bg_upload_files": {
                "description": "上传背景图片",
                "type": "file",
                "default": [],
                "file_types": [
                    "png",
                    "jpg",
                    "jpeg",
                    "webp",
                    "gif"
                ],
                "condition": {
                    "background_source": "upload"
                },
                "hint": "支持 png/jpg/webp/gif，单张不超过 10 MB；取列表第一张。"
            }
        }
    },
    "alerts": {
        "description": "告警与每日定时状态图",
        "type": "object",
        "hint": "默认关闭。打开后，CPU/内存/磁盘持续过高或 Bot 掉线时往 QQ 群发消息；“每日定时状态图”可在下面单独开启。",
        "items": {
            "enabled": {
                "description": "启用资源与掉线告警",
                "type": "bool",
                "default": false,
                "hint": "资源阈值和掉线告警的总开关；不影响“每日定时状态图”和“日报”。"
            },
            "targets": {
                "description": "默认推送目标",
                "type": "list",
                "default": [],
                "items": {
                    "type": "string"
                },
                "hint": "所有通知默认发到这里：资源告警、掉线/恢复、每日定时状态图、服务监测、日报、周报。只填这一处即可，其他模块留空会自动复用。被通知中心对应规则勾选的类型会改发规则目标。"
            },
            "daily_summary": {
                "description": "每日定时状态图",
                "type": "object",
                "hint": "每天定时发送整张状态卡图片，不是趋势日报；与下面的“日报”是两件事。",
                "items": {
                    "enabled": {
                        "description": "启用每日定时状态图",
                        "type": "bool",
                        "default": false,
                        "hint": "独立于上面的“启用资源与掉线告警”，可以只开定时状态图。"
                    },
                    "time": {
                        "description": "发送时间",
                        "type": "string",
                        "default": "09:00",
                        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                        "condition": {
                            "enabled": true
                        },
                        "hint": "24 小时制 HH:MM，例如 20:00；修改后每分钟自动生效。"
                    },
                    "with_image": {
                        "description": "发送状态图（关闭则发文字摘要）",
                        "type": "bool",
                        "default": true,
                        "condition": {
                            "enabled": true
                        },
                        "hint": "关闭后只发文字摘要；图片渲染失败会先降级为本地简化卡，再失败才回退文字。"
                    }
                }
            },
            "show_advanced": {
                "description": "显示高级告警选项",
                "type": "bool",
                "default": false,
                "hint": "阈值、采样间隔、冷却、掉线通知、Komari Webhook 等；通常不需要改。"
            },
            "cpu_threshold": {
                "description": "CPU 告警阈值（%）",
                "type": "int",
                "default": 85,
                "slider": {
                    "min": 0,
                    "max": 100,
                    "step": 1
                },
                "condition": {
                    "show_advanced": true
                },
                "hint": "连续超过该百分比才告警；默认 85。"
            },
            "mem_threshold": {
                "description": "内存告警阈值（%）",
                "type": "int",
                "default": 90,
                "slider": {
                    "min": 0,
                    "max": 100,
                    "step": 1
                },
                "condition": {
                    "show_advanced": true
                },
                "hint": "连续超过该百分比才告警；默认 90，设太低会频繁误报。"
            },
            "swap_threshold": {
                "description": "SWAP 告警阈值（%）",
                "type": "int",
                "default": 90,
                "slider": {
                    "min": 0,
                    "max": 100,
                    "step": 1
                },
                "condition": {
                    "show_advanced": true
                },
                "hint": "连续超过该百分比才告警；默认 90。"
            },
            "disk_threshold": {
                "description": "磁盘告警阈值（%）",
                "type": "int",
                "default": 85,
                "slider": {
                    "min": 0,
                    "max": 100,
                    "step": 1
                },
                "condition": {
                    "show_advanced": true
                },
                "hint": "连续超过该百分比才告警；默认 85，注意磁盘长期高于 80 应尽快清理。"
            },
            "load_per_core_threshold": {
                "description": "每核负载告警阈值",
                "type": "float",
                "default": 2.0,
                "slider": {
                    "min": 0,
                    "max": 16,
                    "step": 0.1
                },
                "condition": {
                    "show_advanced": true
                },
                "hint": "例如 2.0 表示每个 CPU 核心平均负载超过 2.0 时告警。"
            },
            "interval_seconds": {
                "description": "告警采样间隔（秒）",
                "type": "int",
                "default": 60,
                "slider": {
                    "min": 15,
                    "max": 600,
                    "step": 5
                },
                "condition": {
                    "show_advanced": true
                },
                "hint": "只影响资源告警的采样节奏；状态卡网络折线/月流量的采样间隔在「状态卡显示 → 高级」的“采样间隔（秒）”单独设置。"
            },
            "sustain_samples": {
                "description": "连续超过阈值几次才告警（资源告警）",
                "type": "int",
                "default": 3,
                "slider": {
                    "min": 1,
                    "max": 10,
                    "step": 1
                },
                "condition": {
                    "show_advanced": true
                },
                "hint": "只影响 CPU / 内存 / SWAP / 磁盘 / 每核负载；服务监测的失败阈值在「服务可用性监测」分组。默认 3 次，60 秒采样约 3 分钟。"
            },
            "cooldown_seconds": {
                "description": "同一规则告警冷却（秒）",
                "type": "int",
                "default": 1800,
                "slider": {
                    "min": 0,
                    "max": 86400,
                    "step": 60
                },
                "condition": {
                    "show_advanced": true
                },
                "hint": "同一规则成功告警后，多久内不重复提醒。"
            },
            "aggregate_seconds": {
                "condition": {
                    "show_advanced": true
                },
                "description": "告警聚合窗口（秒）",
                "type": "int",
                "default": 120,
                "slider": {
                    "min": 0,
                    "max": 600,
                    "step": 10
                },
                "hint": "第一项告警立即推送；窗口内集中出现的后续告警合并为一条汇总（各项仍单独记录、恢复照常通知）。0 = 关闭聚合。修改后需重载生效。"
            },
            "aggregate_max_items": {
                "condition": {
                    "show_advanced": true
                },
                "description": "汇总最多列出的告警项数",
                "type": "int",
                "default": 8,
                "slider": {
                    "min": 2,
                    "max": 20,
                    "step": 1
                },
                "hint": "超出部分在汇总末尾以“另有 N 项未列出”说明；完整清单见日报的事件记录。"
            },
            "recover_notify": {
                "description": "恢复时发送通知",
                "type": "bool",
                "default": true,
                "condition": {
                    "enabled": true,
                    "show_advanced": true
                },
                "hint": "恢复正常时补发一条「已恢复」通知；关闭后只报故障。"
            },
            "offline_notify": {
                "description": "Bot 掉线/恢复通知",
                "type": "bool",
                "default": true,
                "condition": {
                    "enabled": true,
                    "show_advanced": true
                },
                "hint": "依赖 OneBot 通道；整体断线时会排队，恢复后补发。"
            },
            "offline_broadcast": {
                "description": "掉线恢复全群广播",
                "condition": {
                    "show_advanced": true
                },
                "type": "object",
                "items": {
                    "enabled": {
                        "description": "恢复后向 Bot 加入的全部群广播",
                        "type": "bool",
                        "default": false,
                        "hint": "掉线期间无法发消息，广播在恢复成功后发送一次；默认关闭。群较多时逐群发送耗时较长，并可能增加风控风险，请谨慎开启。"
                    },
                    "template": {
                        "description": "广播文案模板",
                        "type": "string",
                        "default": "✅ Bot 已恢复上线\n掉线时间: {offline_time}\n恢复时间: {recover_time}\n离线时长: {duration}",
                        "hint": "可用占位符：{offline_time} 掉线时刻、{recover_time} 恢复时刻、{duration} 离线时长。其他花括号内容会被原样保留。"
                    },
                    "exclude_groups": {
                        "description": "不参与广播的群号",
                        "type": "list",
                        "default": [],
                        "items": {
                            "type": "string"
                        },
                        "hint": "填 QQ 群号（纯数字），这些群不参与广播；正式恢复通知的目标群会自动跳过。"
                    },
                    "interval_seconds": {
                        "description": "每群广播间隔（秒）",
                        "type": "int",
                        "default": 3,
                        "slider": {
                            "min": 1,
                            "max": 30,
                            "step": 1
                        },
                        "hint": "逐群发送的最小间隔，降低风控风险。"
                    },
                    "max_groups": {
                        "description": "单次广播群数上限",
                        "type": "int",
                        "default": 100,
                        "slider": {
                            "min": 1,
                            "max": 500,
                            "step": 1
                        },
                        "hint": "超过上限的群不再发送；范围 1–500，超过按 500 处理。"
                    }
                },
                "hint": "默认关闭。开启后掉线/恢复会广播到机器人所在的全部群，适合多群运营；只发一个群不用开。"
            },
            "provider_watch": {
                "description": "LLM 服务告警",
                "condition": {
                    "show_advanced": true
                },
                "type": "object",
                "hint": "按 AstrBot 的 provider_stats 记录监测 LLM 调用质量：连续失败达到阈值时告警，恢复后通知。用户主动中止（aborted）不算失败，也不打断连续计数。",
                "items": {
                    "enabled": {
                        "description": "启用 LLM 连续失败告警",
                        "type": "bool",
                        "default": false,
                        "hint": "默认关闭。数据来自 AstrBot 自带的 provider_stats 表（4.26.7+），无需额外配置。"
                    },
                    "threshold": {
                        "description": "连续失败几次后告警",
                        "type": "int",
                        "default": 3,
                        "slider": {
                            "min": 1,
                            "max": 10,
                            "step": 1
                        },
                        "hint": "按时间连续的 provider_stats 记录计算，中间的用户主动中止不打断连续链。"
