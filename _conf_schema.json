{
  "avatar": {
    "description": "头像",
    "type": "object",
    "items": {
      "avatar_local_path": {
        "description": "自定义头像本地路径",
        "type": "string",
        "default": "",
        "hint": "填写后优先读取本地文件；读取失败会回退到 avatar_url 或 QQ 头像。"
      },
      "avatar_url": {
        "description": "自定义头像图片 URL",
        "type": "string",
        "default": "",
        "hint": "留空时自动使用 Bot 的 QQ 头像。"
      },
      "avatar_text": {
        "description": "状态图显示的 Bot 名称",
        "type": "string",
        "default": "",
        "hint": "留空时自动读取 OneBot 登录昵称。"
      }
    }
  },
  "background": {
    "description": "背景",
    "type": "object",
    "items": {
      "bg_provider": {
        "description": "背景获取来源（主）",
        "type": "string",
        "default": "none",
        "options": ["none", "local", "loli", "lolicon", "loli&lolicon"],
        "hint": "none=内置背景；local=本地文件/目录；loli/lolicon=在线随机二次元图。"
      },
      "bg_fallback_chain": {
        "description": "背景回退链",
        "type": "string",
        "default": "none",
        "hint": "逗号分隔，主来源失败后按顺序尝试。"
      },
      "bg_local_path": {
        "description": "本地背景路径（文件或目录）",
        "type": "string",
        "default": "",
        "hint": "目录会随机抽取其中的图片。"
      },
      "bg_preload_count": {
        "description": "预加载背景数量",
        "type": "int",
        "default": 1
      },
      "bg_req_timeout": {
        "description": "在线背景请求超时（秒）",
        "type": "int",
        "default": 10
      },
      "bg_proxy": {
        "description": "在线背景请求代理",
        "type": "string",
        "default": "",
        "hint": "留空不使用代理。"
      },
      "bg_lolicon_r18_type": {
        "description": "Lolicon R18 类型",
        "type": "int",
        "default": 0,
        "hint": "0=正常，1=R18，2=混合；仅 lolicon 来源生效。"
      }
    }
  },
  "display": {
    "description": "状态卡显示",
    "type": "object",
    "items": {
      "process_top_n": {
        "description": "进程表显示条数",
        "type": "int",
        "default": 8
      },
      "website_targets": {
        "description": "网站测试目标",
        "type": "template_list",
        "default": [
          {"name": "Baidu", "url": "https://www.baidu.com/"},
          {"name": "Google", "url": "https://www.google.com/"}
        ],
        "templates": {
          "site": {
            "name": "网站",
            "display_item": "name",
            "items": {
              "name": {
                "description": "显示名称",
                "type": "string",
                "default": ""
              },
              "url": {
                "description": "URL",
                "type": "string",
                "default": ""
              }
            }
          }
        }
      },
      "disk_paths": {
        "description": "磁盘挂载点",
        "type": "list",
        "default": ["/"],
        "items": {
          "type": "string"
        },
        "hint": "例如 [\"/\"] 或 [\"/\", \"/data\"]；Windows 可填 [\"C:\\\\\"]。"
      },
      "timezone": {
        "description": "时间与每日摘要时区",
        "type": "string",
        "default": "Asia/Shanghai"
      }
    }
  },
  "alerts": {
    "description": "主动告警（默认关闭）",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用主动告警",
        "type": "bool",
        "default": false,
        "hint": "首次部署建议保持关闭，确认状态图正常后再开启。"
      },
      "targets": {
        "description": "告警推送目标",
        "type": "list",
        "default": [],
        "items": {
          "type": "string"
        },
        "hint": "支持完整 UMO（platform_id:GroupMessage:群号）或纯群号；留空时不会主动发送。"
      },
      "platform_id": {
        "description": "默认平台实例 ID",
        "type": "string",
        "default": "default",
        "hint": "纯群号会转换为 <platform_id>:GroupMessage:<群号>。"
      },
      "interval_seconds": {
        "description": "告警采样间隔（秒）",
        "type": "int",
        "default": 60,
        "hint": "最低 15 秒。"
      },
      "sustain_samples": {
        "description": "连续超过阈值多少次才告警",
        "type": "int",
        "default": 3
      },
      "cooldown_seconds": {
        "description": "同一规则告警冷却（秒）",
        "type": "int",
        "default": 1800
      },
      "cpu_threshold": {
        "description": "CPU 使用率阈值（%）",
        "type": "int",
        "default": 85
      },
      "mem_threshold": {
        "description": "内存使用率阈值（%）",
        "type": "int",
        "default": 90
      },
      "swap_threshold": {
        "description": "SWAP 使用率阈值（%）",
        "type": "int",
        "default": 90
      },
      "disk_threshold": {
        "description": "磁盘使用率阈值（%）",
        "type": "int",
        "default": 85
      },
      "load_per_core_threshold": {
        "description": "每核负载阈值",
        "type": "float",
        "default": 2.0
      },
      "recover_notify": {
        "description": "恢复时发送通知",
        "type": "bool",
        "default": true
      },
      "offline_notify": {
        "description": "Bot 掉线/恢复通知",
        "type": "bool",
        "default": true
      },
      "daily_summary": {
        "description": "每日状态摘要",
        "type": "object",
        "items": {
          "enabled": {
            "description": "启用每日摘要",
            "type": "bool",
            "default": false
          },
          "time": {
            "description": "发送时间（HH:MM）",
            "type": "string",
            "default": "09:00"
          },
          "with_image": {
            "description": "附带状态图",
            "type": "bool",
            "default": true,
            "hint": "渲染失败时自动降级为文字摘要。"
          }
        }
      },
      "komari_webhook": {
        "description": "Komari Webhook 转发",
        "type": "object",
        "items": {
          "enabled": {
            "description": "启用 Webhook 接收",
            "type": "bool",
            "default": false
          },
          "host": {
            "description": "监听地址",
            "type": "string",
            "default": "127.0.0.1",
            "hint": "Komari 与本插件同机时用 127.0.0.1 即可，避免暴露公网。"
          },
          "port": {
            "description": "监听端口",
            "type": "int",
            "default": 9968
          },
          "path": {
            "description": "Webhook 路径",
            "type": "string",
            "default": "/webhook"
          },
          "token": {
            "description": "鉴权 Token",
            "type": "string",
            "default": "",
            "is_password": true,
            "hint": "填写后 Komari 请求头需带 Authorization: Bearer <token>。"
          }
        }
      }
    }
  }
}
