            },
            "komari_webhook": {
                "description": "Komari Webhook",
                "type": "object",
                "condition": {
                    "show_advanced": true
                },
                "hint": "接收 Komari 的 Webhook 并转发到 QQ 群；普通用户不需要配置。",
                "items": {
                    "enabled": {
                        "description": "启用 Webhook 接收",
                        "type": "bool",
                        "default": false,
                        "hint": "接收 Komari 的 Webhook 事件并转发到推送目标；默认关闭。"
                    },
                    "host": {
                        "description": "监听地址",
                        "type": "string",
                        "default": "127.0.0.1",
                        "condition": {
                            "enabled": true
                        },
                        "hint": "建议保持 127.0.0.1，只允许本机访问。"
                    },
                    "port": {
                        "description": "监听端口",
                        "type": "int",
                        "default": 9968,
                        "slider": {
                            "min": 1,
                            "max": 65535,
                            "step": 1
                        },
                        "condition": {
                            "enabled": true
                        },
                        "hint": "本机监听端口；默认 9968，需与 Komari 的 Webhook 地址一致。"
                    },
                    "path": {
                        "description": "Webhook 路径",
                        "type": "string",
                        "default": "/webhook",
                        "condition": {
                            "enabled": true
                        },
                        "hint": "Webhook 路径；默认 /webhook。"
                    },
                    "token": {
                        "description": "鉴权 Token",
                        "type": "string",
                        "default": "",
                        "secret": true,
                        "condition": {
                            "enabled": true
                        },
                        "hint": "Webhook 的鉴权 Token；是否强制校验取决于下方“强制要求 Token”。不要提交到公开仓库。"
                    },
                    "require_token": {
                        "description": "强制要求 Token",
                        "type": "bool",
                        "default": true,
                        "condition": {
                            "enabled": true
                        },
                        "hint": "开启后必须配置 Token，否则 Webhook 拒绝启动；默认开启，关闭后请务必只监听 127.0.0.1。"
                    }
                }
            }
        }
    },
    "daily_report": {
