{% from 'macros.html.jinja' import header, overview, resources, disk, network, websites, process, sysinfo, footer %}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
{{ page_css | safe }}
  </style>
</head>
<body class="{{ 'compact' if d.compact else '' }}">
  <div class="main-background" style="background-color: {{ d.background_color }}; background-image: {{ d.background_overlay }}, url('{{ d.background_data_url }}')">
    <div class="main-background-mask">
      <div class="main">
        {{ header(d) }}
        {{ overview(d) }}
        {{ resources(d) }}
        {{ disk(d) }}
        {{ network(d) }}
        {{ websites(d) }}
        {{ process(d) }}
        {% if not d.compact %}{{ sysinfo(d) }}{% endif %}
        {{ footer(d) }}
      </div>
    </div>
  </div>
</body>
</html>
